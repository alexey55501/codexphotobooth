<Window x:Class="Photobooth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photobooth" Height="800" Width="1200" WindowState="Maximized">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="#222" Height="60">
            <Button Content="Capture" Command="{Binding NavigateCaptureCommand}" Margin="10" Padding="20" FontSize="18" />
            <Button Content="Templates" Command="{Binding NavigateTemplatesCommand}" Margin="10" Padding="20" FontSize="18" />
            <Button Content="Settings" Command="{Binding NavigateSettingsCommand}" Margin="10" Padding="20" FontSize="18" />
            <Button Content="Sessions" Command="{Binding NavigateSessionsCommand}" Margin="10" Padding="20" FontSize="18" />
            <CheckBox Content="Kiosk" IsChecked="{Binding Settings.KioskMode}" Margin="10" VerticalAlignment="Center" Foreground="White" />
        </StackPanel>
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
