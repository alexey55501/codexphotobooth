<UserControl x:Class="Photobooth.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Output Root" Width="120" VerticalAlignment="Center" />
            <TextBox Text="{Binding Settings.OutputRoot}" Width="400" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Printer" Width="120" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Settings.SelectedPrinter}" Width="300" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Countdown" Width="120" VerticalAlignment="Center" />
            <TextBox Text="{Binding Settings.CountdownSeconds}" Width="80" />
            <TextBlock Text="Shots" Width="80" VerticalAlignment="Center" />
            <TextBox Text="{Binding Settings.ShotsPerSession}" Width="80" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <CheckBox Content="Mock Camera" IsChecked="{Binding Settings.MockCamera}" />
            <CheckBox Content="Kiosk Mode" IsChecked="{Binding Settings.KioskMode}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="10" Width="120" />
        </StackPanel>
    </Grid>
</UserControl>
